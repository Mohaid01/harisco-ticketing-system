{
  "compilerOptions": {
    "target": "ES2022",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "esModuleInterop": true,
    "strict": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "outDir": "./dist",
    "allowImportingTsExtensions": true,
    "noEmit": true,
    "paths": {
      "@types": ["./types/index.ts"],
      "@utils": ["./utils/index.ts"]
    }
  },
  "include": ["**/*.ts"]
}
