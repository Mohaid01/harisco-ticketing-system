# Harisco Ticketing System - Environment Variables

# Server Configuration
PORT=8082
NODE_ENV=development

# Database
# SQLite database path. Defaults to ./database.sqlite if not set.
# In production (Docker), use /app/data/database.sqlite
DB_PATH=./database.sqlite

# JWT Authentication
# Generate with: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=your_jwt_secret_here

# Admin Bootstrap
# Initial password for the seeded admin user (usr-1)
ADMIN_INITIAL_PASSWORD=YourSecurePassword123!

# Default User Password
# Default password for new users created via User Management
VITE_DEFAULT_USER_PASSWORD=harisco123

# Email / SMTP (Optional - for notifications)
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=123
# SMTP_USER=mail@domain.com
# SMTP_PASS=your_app_password
# SMTP_SECURE=false
# SMTP_FROM="FULL_NAME <mail@domain.com>"

# Cloudflare Tunnel (Optional - for external access)
# TUNNEL_TOKEN=your_cloudflare_tunnel_token
